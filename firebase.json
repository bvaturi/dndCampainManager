{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "campaigns",
    "edition": "enterprise",
    "location": "me-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "dataAccessMode": "FIRESTORE_NATIVE"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "stormkeep-barakv01.web.app",
      "stormkeep-barakv01.firebaseapp.com"
    ],
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Stormkeep Campaign Manager",
        "supportEmail": "barakv01@gmail.com"
      }
    }
  },
  "emulators": {
    "firestore": {
      "port": 8085,
      "edition": "enterprise"
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
