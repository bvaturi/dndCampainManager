rules_version = '2';

// Campaign Codex security rules.
// Roles: platform manager (admin) > Dungeon Master of a campaign > invited player.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // Email-based roles (manager, DM) only count for verified emails, so nobody can claim one by typing it in.
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    // Platform managers: keep this list in sync with VITE_ADMIN_EMAILS in .env.
    // More managers can be added from the app (stored in /admins/{email}).
    function isAdmin() {
      return verified() && (
        myEmail() in ['barakv01@gmail.com', 'barakvaturi@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(myEmail()))
      );
    }

    function campaignDoc(cid) { return get(/databases/$(database)/documents/campaigns/$(cid)).data; }
    function isDm(cid) { return verified() && campaignDoc(cid).dmEmail == myEmail(); }
    function isOwner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    function isMember(cid) {
      return signedIn() && exists(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid));
    }
    function canManage(cid) { return isAdmin() || isDm(cid); }
    function canView(cid) { return canManage(cid) || isMember(cid); }
    // The map on the table (campaigns/{cid}/combat/map), written by the DM only.
    function mapState(cid) { return get(/databases/$(database)/documents/campaigns/$(cid)/combat/map).data; }

    // A suggestion may be for no character or for one character the suggesting player owns.
    function ownCharacterGrant(cid, granted) {
      return granted is list && (
        granted.size() == 0 || (
          granted.size() == 1
          && get(/databases/$(database)/documents/campaigns/$(cid)/characters/$(granted[0])).data.ownerUid == request.auth.uid
        )
      );
    }

    function validInvite(cid, token) {
      let inv = get(/databases/$(database)/documents/campaigns/$(cid)/invites/$(token)).data;
      return inv.campaignId == cid
        && inv.revoked == false
        && inv.expiresAt > request.time.toMillis()
        && (inv.email == null || inv.email == myEmail());
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /admins/{email} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /dms/{email} {
      allow read, write: if isAdmin();
    }

    match /campaigns/{cid} {
      allow get: if isAdmin() || (verified() && resource.data.dmEmail == myEmail()) || isMember(cid);
      allow list: if isAdmin() || (verified() && resource.data.dmEmail == myEmail());
      allow create, delete: if isAdmin();
      // A DM can edit their campaign but cannot hand it to someone else.
      allow update: if isAdmin() || (
        verified() && resource.data.dmEmail == myEmail()
        && request.resource.data.dmEmail == resource.data.dmEmail
        && request.resource.data.createdBy == resource.data.createdBy
      );

      match /invites/{token} {
        allow get: if signedIn();             // the token itself is the secret
        allow list, create, delete: if canManage(cid);
        // Joining bumps the counter in the same batch that creates the member doc.
        allow update: if canManage(cid) || (
          signedIn()
          && existsAfter(/databases/$(database)/documents/campaigns/$(cid)/members/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1
        );
      }

      match /members/{uid} {
        allow read: if canView(cid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && validInvite(cid, request.resource.data.inviteToken);
        allow delete: if canManage(cid) || (signedIn() && request.auth.uid == uid);
      }

      // A character can be changed only by its owner (while still in the campaign), the campaign's DM,
      // or a platform manager. Party members can read it. Nobody can hand it to another player.
      match /characters/{chid} {
        allow read: if canView(cid);
        allow create: if isMember(cid)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.campaignId == cid;
        allow update: if (canManage(cid) || (isOwner() && isMember(cid)))
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.campaignId == cid;
        allow delete: if canManage(cid) || (isOwner() && isMember(cid));
      }

      match /sessions/{sid} {
        allow read: if canView(cid);
        allow write: if canManage(cid);
      }

      match /private/{docId} {
        allow read, write: if canManage(cid);
      }

      // ---- combat manager
      match /combat/{docId} {
        allow read: if canView(cid);
        allow write: if canManage(cid);
      }
      // Initiative order. A player may add only their own character and change only its initiative roll
      // (and, when the DM allows it, move its token on the map on the table);
      // enemies, turns, conditions and hidden entries are the DM's. Hidden entries are invisible to players.
      match /combatants/{id} {
        allow read: if canManage(cid) || (isMember(cid) && resource.data.hidden == false);
        allow create: if canManage(cid) || (
          isMember(cid)
          && request.resource.data.kind == 'pc'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.hidden == false
          && get(/databases/$(database)/documents/campaigns/$(cid)/characters/$(id)).data.ownerUid == request.auth.uid
        );
        allow update: if canManage(cid) || (
          isMember(cid)
          && resource.data.kind == 'pc'
          && resource.data.ownerUid == request.auth.uid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['initiative', 'roll', 'dexMod', 'name'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mapPos'])
              && mapState(cid).playersMove == true
              && request.resource.data.mapPos.mapId == mapState(cid).mapId
              && request.resource.data.mapPos.keys().hasOnly(['mapId', 'x', 'y'])
              && request.resource.data.mapPos.x is int && request.resource.data.mapPos.y is int
            )
          )
        );
        allow delete: if canManage(cid);
      }
      // Enemy HP / AC / notes: DM only.
      match /combatSecrets/{id} {
        allow read, write: if canManage(cid);
      }

      // ---- battle maps: the DM's library. Players can read only the map on the table, never the rest
      // (so maps prepared for later stay secret). Images live in Firestore docs (no Cloud Storage on Spark).
      match /maps/{mapId} {
        allow read: if canManage(cid) || (isMember(cid) && mapState(cid).mapId == mapId);
        allow write: if canManage(cid);
      }
      match /mapImages/{mapId} {
        allow read: if canManage(cid) || (isMember(cid) && mapState(cid).mapId == mapId);
        allow write: if canManage(cid);
      }

      // ---- homebrew library (spells and abilities). The DM curates it; approved items are visible to the party.
      // Players may suggest: a pending item they created, granted at most to one character of their own,
      // which they can edit or withdraw until the DM approves it. Only the DM approves or grants.
      match /homebrew/{hid} {
        allow read: if canManage(cid) || (
          isMember(cid) && (resource.data.status == 'approved' || resource.data.createdBy == request.auth.uid)
        );
        allow create: if canManage(cid) || (
          isMember(cid)
          && hid.matches('hb-[A-Za-z0-9]+')
          && request.resource.data.kind in ['spell', 'ability']
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.campaignId == cid
          && ownCharacterGrant(cid, request.resource.data.grantedTo)
        );
        allow update: if canManage(cid) || (
          isMember(cid)
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.campaignId == cid
          && request.resource.data.kind == resource.data.kind
          && ownCharacterGrant(cid, request.resource.data.grantedTo)
        );
        allow delete: if canManage(cid) || (
          isMember(cid) && resource.data.createdBy == request.auth.uid && resource.data.status == 'pending'
        );
      }
    }

    // Collection-group queries ("my campaigns", "my characters", "all characters").
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/characters/{chid} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
  }
}
