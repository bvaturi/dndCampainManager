{
  "name": "dnd-campaign-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project codex-rules-test \"node --test tests/rules.test.mjs\"",
    "test:unit": "tsx --test tests/*.test.mts",
    "data:merge": "python3 -I scripts/merge_phb_audit.py && python3 -I scripts/merge_races.py"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
