# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Google emails that are platform managers (must match firestore.rules)
VITE_ADMIN_EMAILS=barakvaturi@gmail.com

# Leave empty to use Firebase. Set to "true" to run fully offline in the browser
# (fake sign-in, data in localStorage) - handy for trying things out.
VITE_DEMO_MODE=
